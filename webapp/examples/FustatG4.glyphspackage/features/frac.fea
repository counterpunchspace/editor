lookup FRAC {
	sub slash by fraction;
} FRAC;
lookup UP {
	sub [zero-ar zeroFarsi-ar zeroFarsi-ar.locl one-ar two-ar twoFarsi-ar three-ar four-ar fourFarsi-ar fourFarsi-ar.locl five-ar fiveFarsi-ar six-ar sixFarsi-ar seven-ar sevenFarsi-ar sevenFarsi-ar.locl eight-ar nine-ar zero one two three four five six seven eight nine] by [zero-ar.numr zeroFarsi-ar.numr zeroFarsi-ar.locl.numr one-ar.numr two-ar.numr twoFarsi-ar.numr three-ar.numr four-ar.numr fourFarsi-ar.numr fourFarsi-ar.locl.numr five-ar.numr fiveFarsi-ar.numr six-ar.numr sixFarsi-ar.numr seven-ar.numr sevenFarsi-ar.numr sevenFarsi-ar.locl.numr eight-ar.numr nine-ar.numr zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr];
} UP;
lookup DOWN {
