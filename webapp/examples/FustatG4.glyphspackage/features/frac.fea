	sub [zero-ar.dnom zeroFarsi-ar.dnom zeroFarsi-ar.locl.dnom one-ar.dnom two-ar.dnom twoFarsi-ar.dnom three-ar.dnom four-ar.dnom fourFarsi-ar.dnom fourFarsi-ar.locl.dnom five-ar.dnom fiveFarsi-ar.dnom six-ar.dnom sixFarsi-ar.dnom seven-ar.dnom sevenFarsi-ar.dnom sevenFarsi-ar.locl.dnom eight-ar.dnom nine-ar.dnom zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom] [zero-ar.numr zeroFarsi-ar.numr zeroFarsi-ar.locl.numr one-ar.numr two-ar.numr twoFarsi-ar.numr three-ar.numr four-ar.numr fourFarsi-ar.numr fourFarsi-ar.locl.numr five-ar.numr fiveFarsi-ar.numr six-ar.numr sixFarsi-ar.numr seven-ar.numr sevenFarsi-ar.numr sevenFarsi-ar.locl.numr eight-ar.numr nine-ar.numr zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr]' by [zero-ar.dnom zeroFarsi-ar.dnom zeroFarsi-ar.locl.dnom one-ar.dnom two-ar.dnom twoFarsi-ar.dnom three-ar.dnom four-ar.dnom fourFarsi-ar.dnom fourFarsi-ar.locl.dnom five-ar.dnom fiveFarsi-ar.dnom six-ar.dnom sixFarsi-ar.dnom seven-ar.dnom sevenFarsi-ar.dnom sevenFarsi-ar.locl.dnom eight-ar.dnom nine-ar.dnom zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom];
