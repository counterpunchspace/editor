{
    "name": "context",
    "version": "1.0.0",
    "type": "commonjs",
    "main": "coi-serviceworker.js",
    "scripts": {
        "test": "npm run test:checks && playwright test --project=chromium",
        "test:cloud-collab": "CLOUD_COLLAB_E2E=1 playwright test --project=cloud-collab",
        "test:checks": "npm --prefix .. exec -- gitnexus analyze && npm --prefix .. run test:graph-chokepoints && npm --prefix .. run check:graph-chokepoints && npm run test:type-drift && npm run test:tsc && npm run test:jest",
        "test:dead-code": "knip --include files,dependencies,unlisted",
        "test:type-drift": "cd .. && ./check-type-drift.sh",
        "test:tsc": "tsc --noEmit",
        "test:any-budget": "node scripts/check-explicit-any-budget.mjs",
        "test:update-type-keywords": "node scripts/update-type-keywords.mjs",
        "test:ui": "playwright test --ui",
        "test:record": "node scripts/playwright-codegen.mjs",
        "test:debug": "playwright test --debug",
        "test:headed": "playwright test --headed",
        "test:report": "playwright show-report",
        "test:snapshots": "playwright test --update-snapshots=changed",
        "format:snapshot-json": "node scripts/format-snapshot-json.mjs",
        "test:compile-bench": "COMPILE_BENCH=1 playwright test tests/compilation-lane-benchmark.spec.ts",
        "bench:cloud-shard-io": "CLOUD_COLLAB_E2E=1 SHARD_IO_BENCH=1 playwright test --config=playwright.shard-io-bench.config.ts",
        "test:jest": "jest --runInBand --verbose tests/",
        "test:rename-glyphs-wasm": "node tests/rename-glyphs-wasm-integration.mjs",
        "format": "prettier --write .",
        "prepare": "husky",
        "tutorial:outline:audio": "node scripts/tutorial/generate-outline-tutorial-audio.mjs",
        "tutorial:outline:record": "node scripts/tutorial/record-outline-tutorial.mjs",
        "tutorial:outline:assemble": "node scripts/tutorial/assemble-outline-tutorial.mjs",
        "tutorial:outline:make": "node scripts/tutorial/make-outline-tutorial.mjs",
        "tokens": "node scripts/generate-css-tokens.js",
        "glyph-data": "python3 scripts/build-glyph-data.py",
        "ensure:local-https": "node scripts/ensure-local-https.cjs",
        "dev": "npm run ensure:local-https && npm run tokens && webpack serve",
        "build": "npm run tokens && NODE_ENV=production webpack",
        "serve": "npm run ensure:local-https && npm run tokens && webpack serve --mode development",
        "serve:ci": "npx http-server build -p 9000"
    },
    "devDependencies": {
        "@babel/core": "^7.28.5",
        "@babel/preset-env": "^7.28.5",
        "@babel/preset-typescript": "^7.28.5",
        "@google/genai": "^1.48.0",
        "@playwright/test": "^1.57.0",
        "@types/bezier-js": "^4.1.3",
        "@types/node": "^24.10.0",
        "babel-jest": "^30.2.0",
        "babel-loader": "^10.0.0",
        "chokidar": "^5.0.0",
        "copy-webpack-plugin": "^13.0.1",
        "css-loader": "^7.1.2",
        "html-webpack-plugin": "^5.6.5",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "jest-canvas-mock": "^2.5.2",
        "jest-environment-jsdom": "^30.2.0",
        "knip": "^5.85.0",
        "prettier": "^3.9.4",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "unused-webpack-plugin": "^2.4.0",
        "webpack": "^5.103.0",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.2"
    },
    "dependencies": {
        "@simoncozens/fonttypes": "^1.0.0",
        "bezier-js": "^6.1.4",
        "bidi-js": "^1.0.3",
        "idb-keyval": "^6.2.2",
        "opfs-worker": "^1.3.1",
        "source-map-js": "^1.2.1",
        "tippy.js": "^6.3.7",
        "yjs": "^13.6.29"
    }
}
